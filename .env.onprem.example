# ─────────────────────────────────────────────────────────────────────────────
# GRC Platform — on-prem client configuration
# Copy to .env.onprem next to docker-compose.onprem.yml and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# REQUIRED — long random secret for JWT signing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The backend refuses to start in production with a weak/default value.
SECRET_KEY=REPLACE_ME_WITH_64_RANDOM_URLSAFE_CHARS

# ── Licensing ────────────────────────────────────────────────────────────────
# Protected builds have enforcement + the public key baked in; these env values
# are a fallback for unprotected/test builds and are harmless to set on both.
LICENSE_ENFORCEMENT=true
LICENSE_PUBLIC_KEY=

# ── Network ──────────────────────────────────────────────────────────────────
# JSON list. Add the hostname/IP users type into their browser for this server.
# The bundled nginx proxies /api same-origin, so this mostly matters if the
# API is ever exposed on a separate hostname.
ALLOWED_ORIGINS=["http://grc.client.lan"]
FRONTEND_URL=http://grc.client.lan
FRONTEND_BASE_URL=http://grc.client.lan

# ── AI (optional) ────────────────────────────────────────────────────────────
# Point at the client's GPU box, an in-country hosted provider, or the optional
# bundled "ai" compose profile (http://ai:11434). AI features degrade
# gracefully when unreachable.
OLLAMA_BASE_URL=http://ai:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b

# ── Email (optional on-prem) ─────────────────────────────────────────────────
# Leave empty to disable outbound email — in-app notifications still work.
# Fill with the client's SMTP relay to enable deadline/alert emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
