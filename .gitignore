# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.env
!.env.example
dist/
build/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Node / Frontend
node_modules/
frontend/dist/
frontend/.vite/
*.log
.npm

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
*.override.yml

# Alembic
alembic/versions/__pycache__/

# Secrets — never commit env files except the example template
*.pem
*.key
credentials.json
.env.local
.env.dev
.env.production
backend/.env.local
backend/.env.dev
backend/.env.production
frontend/.env.local
frontend/.env.production

# Live database + snapshots — never commit real client data
backend/grc_dev.db
backend/grc_dev.db.bak-*
backend/grc_dev.db.pre-*
backend/grc_dev.db.*.bak
backend/grc_dev.db-wal
backend/grc_dev.db-shm

# Local DB backups (rotated by scripts.backup_db)
backend/backups/

# Client-uploaded evidence, contracts and documents. These are real customer
# files: they belong on the server disk (and in the backup), never in version
# control, where every clone would carry them. .dockerignore already excludes
# this path from images for the same reason.
backend/uploads/
.deploy-backup-*/

# Local pre-change copies of stale SEO assets (see the 2026-09-08 SEO pass)
.seo-stale-backup-*/

# Pre-upgrade dependency + dist snapshots (2026-09-09 vulnerability pass)
.deps-rollback-*/
