# ─────────────────────────────────────────────────────────────────────────────
# GRC Platform — TEST backend image (NOT for client delivery)
#
# Build context = REPO ROOT:
#   docker build -f infrastructure/docker/Dockerfile.backend.test -t grc-backend:test .
#
# This packages the PLAIN Python source (readable) — NO PyArmor obfuscation and
# NO license enforcement — so you can quickly run the whole app in Docker on any
# machine to see it work. It needs no PyArmor license and no signing keys.
#
# ⚠️  Because it ships readable source and unlocks everything, use it ONLY for
#     your own testing. The real client deliverable is the obfuscated,
#     license-enforced Dockerfile.backend.onprem image.
#
# Prerequisite: release/seed/grc_seed.db must exist (built by
# backend/scripts/make_client_seed_db.py) — the clean, client-data-free DB.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

WORKDIR /srv
ENV PYTHONPATH=/srv

# Plain application source (no obfuscation for the test build).
COPY backend/app /srv/app
COPY backend/alembic /srv/alembic
COPY backend/alembic.ini /srv/alembic.ini
COPY frameworks /frameworks

# Clean seed database — copied to /data/grc.db on first boot by the entrypoint.
COPY release/seed/grc_seed.db /seed/grc_seed.db

COPY infrastructure/docker/entrypoint.backend.sh /entrypoint.sh
RUN chmod 0755 /entrypoint.sh

RUN groupadd -r grc && useradd -r -g grc -d /srv grc \
    && mkdir -p /data \
    && chown -R grc:grc /srv /seed /data
USER grc

EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
