# ─────────────────────────────────────────────────────────────────────────────
# GRC Platform — on-prem frontend image (SPA + nginx reverse proxy)
#
# Build context = REPO ROOT:
#   docker build -f infrastructure/docker/Dockerfile.frontend.onprem \
#       -t grc-frontend:onprem .
#
# The SPA calls the API at VITE_API_URL (default /api/v1 — same-origin);
# nginx proxies /api/ to the backend container.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

# Same-origin API by default — nginx proxies /api/ to the backend service.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL

# Building inside the container is safe: nothing under the host's
# frontend/dist is touched.
RUN npx vite build

# Never ship source maps to a client install — fail the build if any exist.
RUN if find dist -name '*.map' | grep -q .; then \
        echo "ERROR: source maps found in build output — refusing to ship" >&2; \
        find dist -name '*.map' >&2; \
        exit 1; \
    fi

FROM nginx:alpine AS production

COPY --from=build /app/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.onprem.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
