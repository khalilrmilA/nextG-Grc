# This machine has core.autocrlf=true. Without these rules git converts LF to
# CRLF on checkout, every shell script arrives in the Linux guest with a
# trailing \r, and the build dies with:
#
#     bad interpreter: /usr/bin/env bash^M
#
# which does not obviously point at line endings. The Packer templates and
# build-ova-local.sh also run dos2unix inside the guest as a second line of
# defence, but the fix belongs here first.
#
# Scoped to this directory on purpose: a repository-wide rule would renormalise
# the frontend and marketing trees as a side effect.

*.sh            text eol=lf
*.py            text eol=lf
*.hcl           text eol=lf
*.pkrtpl.hcl    text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
*.xml           text eol=lf
*.md            text eol=lf
user-data       text eol=lf
meta-data       text eol=lf
admin-reset     text eol=lf
support-verify  text eol=lf
sign-challenge  text eol=lf

# PowerShell is happy with either; keep it LF so the tree is uniform.
*.ps1           text eol=lf
