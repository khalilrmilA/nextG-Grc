#!/usr/bin/env python3
"""Sign an appliance support challenge. Vendor side only.

This is the other half of /opt/appliance/bin/support-verify. It runs on the
vendor's infrastructure, never on a customer appliance, and it is the only
place the private key is ever touched.

    # once, to create the keypair
    ./sign-challenge keygen --out-private ~/.secrets/support-ed25519.key

    # bake the printed public key into the image at build time
    export SUPPORT_PUBLIC_KEY='<the public key it printed>'

    # every time a customer reads a challenge off their console
    ./sign-challenge sign --key ~/.secrets/support-ed25519.key 3f2a...c91d

The private key is read from --key or from SUPPORT_PRIVATE_KEY. It must never
be committed, never be passed on a command line (argv is world readable through
/proc), and never be copied onto an appliance. Anyone holding it can open a root
shell on every appliance carrying the matching public key.

The response is only usable for a few hours: the appliance rebuilds the
expected challenge from its machine id, its version and the current UTC hour,
and rejects anything outside that window. Signing an old challenge produces a
response that will be refused.

Requires: python3 and the "cryptography" package (pip install cryptography).
"""
from __future__ import annotations

import argparse
import base64
import os
import stat
import sys

try:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey
except ImportError:  # pragma: no cover
    print("error: pip install cryptography", file=sys.stderr)
    raise SystemExit(3) from None


def read_private_key(path: str | None) -> Ed25519PrivateKey:
    """Load the 32 byte Ed25519 seed, base64 encoded, from a file or the env."""
    raw = ""
    if path:
        if not os.path.exists(path):
            raise SystemExit(f"error: no such key file: {path}")
        # POSIX only: Windows reports 0666 for every file regardless of its ACL,
        # so enforcing this there would refuse to run on a perfectly safe key.
        if os.name == "posix":
            mode = stat.S_IMODE(os.stat(path).st_mode)
            if mode & 0o077:
                # Refuse rather than warn: a group or world readable signing key
                # is the whole security model gone.
                raise SystemExit(
                    f"error: {path} is mode {mode:04o}; run: chmod 600 {path}"
                )
        with open(path, encoding="utf-8") as handle:
            raw = handle.read().strip()
    else:
        raw = os.environ.get("SUPPORT_PRIVATE_KEY", "").strip()

    if not raw:
        raise SystemExit(
            "error: no private key. Pass --key <file> or set SUPPORT_PRIVATE_KEY."
        )
    try:
        return Ed25519PrivateKey.from_private_bytes(base64.b64decode(raw))
    except Exception as exc:  # noqa: BLE001
        raise SystemExit(f"error: not a valid Ed25519 private key: {exc}") from exc


def cmd_keygen(args: argparse.Namespace) -> int:
    private = Ed25519PrivateKey.generate()
    private_b64 = base64.b64encode(private.private_bytes_raw()).decode("ascii")
    public_b64 = base64.b64encode(private.public_key().public_bytes_raw()).decode("ascii")

    if args.out_private:
        # 0600 from the moment it exists, never world readable even briefly.
        fd = os.open(args.out_private, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(private_b64 + "\n")
        print(f"private key written to {args.out_private} (mode 0600)", file=sys.stderr)
    else:
        print("PRIVATE (keep this secret, never ship it):", file=sys.stderr)
        print(private_b64)

    print("PUBLIC (bake into the image as SUPPORT_PUBLIC_KEY):", file=sys.stderr)
    print(public_b64)
    return 0


def cmd_sign(args: argparse.Namespace) -> int:
    challenge = args.challenge.strip()
    if not challenge:
        raise SystemExit("error: empty challenge")

    private = read_private_key(args.key)
    signature = private.sign(challenge.encode("ascii"))
    print(base64.b64encode(signature).decode("ascii"))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="sign-challenge",
        description="Sign an appliance support challenge (vendor side only)",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p_keygen = sub.add_parser("keygen", help="generate a support signing keypair")
    p_keygen.add_argument("--out-private", default=None,
                          help="write the private key here (mode 0600)")
    p_keygen.set_defaults(func=cmd_keygen)

    p_sign = sub.add_parser("sign", help="sign a challenge string")
    p_sign.add_argument("challenge", help="the challenge shown on the appliance console")
    p_sign.add_argument("--key", default=None,
                        help="private key file (default: $SUPPORT_PRIVATE_KEY)")
    p_sign.set_defaults(func=cmd_sign)

    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
