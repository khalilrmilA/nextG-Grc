# ─────────────────────────────────────────────────────────────────────────────
# GRC Platform — on-prem client configuration
# Copy to .env.onprem next to docker-compose.onprem.yml and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# REQUIRED — long random secret for JWT signing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The backend refuses to start in production with a weak/default value.
SECRET_KEY=REPLACE_ME_WITH_64_RANDOM_URLSAFE_CHARS

# ── Licensing ────────────────────────────────────────────────────────────────
# Protected builds have enforcement + the public key baked in; these env values
# are a fallback for unprotected/test builds and are harmless to set on both.
LICENSE_ENFORCEMENT=true
LICENSE_PUBLIC_KEY=

# Optional. Base URL of the vendor license server (e.g. https://grceye.com).
# Leave empty for a fully air-gapped, offline-only deployment (the default —
# nothing below this line is contacted unless it's set). When set, enables
# online activation (POST /license/activate-online) and periodic phone-home
# revocation checks (every LICENSE_PHONE_HOME_INTERVAL_HOURS, default 12) —
# see backend/app/services/license_phone_home.py. A blip in reaching this URL
# never locks the deployment out; only an explicit "revoked" answer does.
LICENSE_SERVER_URL=
LICENSE_PHONE_HOME_INTERVAL_HOURS=12
ENABLE_LICENSE_PHONE_HOME=1

# ── Network ──────────────────────────────────────────────────────────────────
# JSON list. Add the hostname/IP users type into their browser for this server.
# The bundled nginx proxies /api same-origin, so this mostly matters if the
# API is ever exposed on a separate hostname.
ALLOWED_ORIGINS=["http://grc.client.lan"]
FRONTEND_URL=http://grc.client.lan
FRONTEND_BASE_URL=http://grc.client.lan

# ── AI (optional) ────────────────────────────────────────────────────────────
# Point at the client's GPU box, an in-country hosted provider, or the optional
# bundled "ai" compose profile (http://ai:11434). AI features degrade
# gracefully when unreachable.
OLLAMA_BASE_URL=http://ai:11434
OLLAMA_CHAT_MODEL=qwen2.5:14b

# ── Active Directory / LDAP ──────────────────────────────────────────────────
# Central authentication against the client's AD. Leave LDAP_ENABLED=false to
# use local passwords only.
LDAP_ENABLED=false
LDAP_SERVER_URI=ldaps://ad.client.lan:636
LDAP_USE_SSL=true
LDAP_BIND_DN=CN=svc_grc,OU=Services,DC=client,DC=lan
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=OU=Users,DC=client,DC=lan
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DEFAULT_TENANT_SLUG=
LDAP_AUTO_CREATE=true

# Entitlements from AD groups. With this map set, the directory is the source
# of truth for rights: the role is recomputed at every sign-in, so moving a
# user between AD groups takes effect on their next login with nothing to
# change in the app. Keys match a group's CN or its full DN, case-insensitively;
# a user in several mapped groups gets the most privileged of them.
# Valid roles: ciso, risk_manager, compliance_manager, auditor, policy_manager,
# vendor_manager, control_owner, business_owner, security_analyst, executive,
# viewer. tenant_admin and super_admin are deliberately NOT grantable from a
# directory group (same rule as in-app role assignment) — those stay manual.
# If the directory returns no groups for a user, their role is left unchanged
# rather than reset, so an AD read failure can't demote everyone at once.
# LDAP_GROUP_ROLE_MAP={"GRC_RSSI":"ciso","GRC_Risques":"risk_manager","GRC_Conformite":"compliance_manager","GRC_Auditeurs":"auditor","GRC_Lecture":"viewer"}
LDAP_GROUP_ROLE_MAP=
# Role for a directory user matching no mapped group (and for every user when
# no map is configured at all).
LDAP_DEFAULT_ROLE=viewer

# ── Email (optional on-prem) ─────────────────────────────────────────────────
# Leave empty to disable outbound email — in-app notifications still work.
# Fill with the client's SMTP relay to enable deadline/alert emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
