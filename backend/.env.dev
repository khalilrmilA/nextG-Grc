APP_NAME=GRC Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=dev-secret-key-do-not-use-in-production-abc123
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

DATABASE_URL=postgresql+asyncpg://grc:grc_dev_password@postgres:5432/grc
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=grc
KEYCLOAK_CLIENT_ID=grc-backend
KEYCLOAK_CLIENT_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_EVIDENCE=grc-evidence-dev
S3_BUCKET_DOCUMENTS=grc-documents-dev

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@grcplatform.dev

SENTRY_DSN=

ENABLE_AI_COPILOT=false
ENABLE_CONTINUOUS_MONITORING=false
