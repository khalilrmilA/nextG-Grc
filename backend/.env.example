# GRC Platform — Backend Environment Variables
# Copy this to .env and fill in values

# App
APP_NAME=GRC Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALLOWED_ORIGINS=["http://localhost:3000"]

# Database
DATABASE_URL=postgresql+asyncpg://grc:grc_dev_password@localhost:5432/grc
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Auth / JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Keycloak (SSO — optional for development)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=grc
KEYCLOAK_CLIENT_ID=grc-backend
KEYCLOAK_CLIENT_SECRET=

# AWS S3 (required for evidence file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_EVIDENCE=grc-evidence-dev
S3_BUCKET_DOCUMENTS=grc-documents-dev

# AI (Anthropic Claude — for AI Copilot feature)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Stripe (for billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@grcplatform.com

# Sentry (error tracking)
SENTRY_DSN=

# Feature Flags
ENABLE_AI_COPILOT=false
ENABLE_CONTINUOUS_MONITORING=false
