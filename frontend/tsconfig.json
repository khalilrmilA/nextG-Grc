{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Next.js copies of the marketing site (next/link, next/navigation) that no SPA
  // route imports, so Vite never bundles them; the real versions live in
  // marketing/. Excluded so `tsc` reports only the app's own errors.
  "exclude": [
    "src/components/landing/PublicFooter.tsx",
    "src/components/landing/PublicNav.tsx",
    "src/components/landing/SupportChat.tsx",
    "src/pages/HowItWorksPage.tsx",
    "src/pages/SolutionsPage.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
